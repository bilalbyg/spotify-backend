# JWT secret key must be base64-encoded and shared by auth-service and catalog-service.
JWT_SECRET_KEY=CHANGE_ME_BASE64_JWT_SECRET

# JWT token expiration in milliseconds.
JWT_EXPIRATION_TIME=CHANGE_ME_JWT_EXPIRATION_TIME

# One-time bootstrap admin email.
ADMIN_EMAIL=CHANGE_ME_ADMIN_EMAIL

# One-time bootstrap admin username.
ADMIN_USERNAME=CHANGE_ME_ADMIN_USERNAME

# One-time bootstrap admin password in base64.
ADMIN_PASSWORD_B64=CHANGE_ME_BASE64_ADMIN_PASSWORD
