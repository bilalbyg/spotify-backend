# Catalog PostgreSQL
CATALOG_DB_USER=CHANGE_ME_CATALOG_DB_USER
CATALOG_DB_PASSWORD=CHANGE_ME_CATALOG_DB_PASSWORD

# Auth MySQL
AUTH_DB_NAME=CHANGE_ME_AUTH_DB_NAME
AUTH_DB_USER=CHANGE_ME_AUTH_DB_USER
AUTH_DB_PASSWORD=CHANGE_ME_AUTH_DB_PASSWORD
AUTH_DB_ROOT_PASSWORD=CHANGE_ME_AUTH_DB_ROOT_PASSWORD

# MongoDB
MONGO_ROOT_USERNAME=CHANGE_ME_MONGO_ROOT_USERNAME
MONGO_ROOT_PASSWORD=CHANGE_ME_MONGO_ROOT_PASSWORD

# MinIO
MINIO_ROOT_USER=CHANGE_ME_MINIO_ROOT_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT_PASSWORD
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_BUCKET_NAME=CHANGE_ME_MINIO_BUCKET_NAME

# JWT secret key must be base64-encoded and shared by auth-service and catalog-service.
JWT_SECRET_KEY=CHANGE_ME_BASE64_JWT_SECRET

# JWT token expiration in milliseconds.
JWT_EXPIRATION_TIME=CHANGE_ME_JWT_EXPIRATION_TIME

# One-time bootstrap admin credentials.
ADMIN_EMAIL=CHANGE_ME_ADMIN_EMAIL
ADMIN_USERNAME=CHANGE_ME_ADMIN_USERNAME

# One-time bootstrap admin password in base64.
ADMIN_PASSWORD_B64=CHANGE_ME_BASE64_ADMIN_PASSWORD
